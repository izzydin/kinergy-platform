// Kinergy Platform - Prisma Database Schema
// Bounded Context: Identity & Access Management (IAM)
// Datasource: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  LOCKED
  SUSPENDED
  DEACTIVATED
}

enum RoleType {
  SYSTEM
  CUSTOM
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(PENDING_ACTIVATION)
  roleId       String     @map("role_id")
  tenantId     String?    @map("tenant_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  role Role @relation("UserToRole", fields: [roleId], references: [id], onDelete: Restrict)

  refreshTokens RefreshToken[] @relation("UserToRefreshTokens")

  @@index([email])
  @@index([roleId])
  @@index([status])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  familyId  String   @map("family_id")
  userId    String   @map("user_id")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation("UserToRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  type        RoleType @default(CUSTOM)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]           @relation("UserToRole")
  permissions RolePermission[] @relation("RoleToRolePermissions")

  @@index([name])
  @@index([type])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[] @relation("PermissionToRolePermissions")

  @@index([code])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role       Role       @relation("RoleToRolePermissions", fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation("PermissionToRolePermissions", fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], name: "unique_role_permission")
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ==========================================
// CLIENT BOUNDED CONTEXT
// ==========================================

model Client {
  id                   String   @id @default(uuid())
  referenceNumber      String   @unique @map("reference_number")
  identityId           String?  @unique @map("identity_id")
  firstName            String   @map("first_name")
  lastName             String   @map("last_name")
  email                String   @map("email")
  phone                String   @map("phone")
  normalizedEmail      String   @map("normalized_email")
  normalizedPhone      String   @map("normalized_phone")
  normalizedSearchName String   @map("normalized_search_name")
  status               String   @default("ACTIVE") @map("status")
  version              Int      @default(1) @map("version")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  timelineEntries ClientTimelineEntry[] @relation("ClientToTimeline")

  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([normalizedSearchName])
  @@index([status])
  @@map("clients")
}

model ClientTimelineEntry {
  id           String   @id @default(uuid())
  clientId     String   @map("client_id")
  sourceModule String   @map("source_module")
  eventType    String   @map("event_type")
  summary      String
  metadata     Json     @default("{}")
  occurredAt   DateTime @map("occurred_at")
  createdAt    DateTime @default(now()) @map("created_at")

  client Client @relation("ClientToTimeline", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, occurredAt(sort: Desc)])
  @@index([eventType])
  @@map("client_timeline_entries")
}

// ==========================================
// SCHEDULING BOUNDED CONTEXT
// ==========================================

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum SeriesStatus {
  ACTIVE
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum ExceptionType {
  SKIPPED
  MODIFIED
}

enum RoomStatus {
  AVAILABLE
  UNAVAILABLE
  MAINTENANCE
}

enum ResourceType {
  ROOM
  EQUIPMENT
  THERAPY_BED
  RENTAL_FACILITY
}

model RecurrenceSeries {
  id                 String              @id @default(uuid())
  clientId           String              @map("client_id")
  therapistId        String              @map("therapist_id")
  roomId             String              @map("room_id")
  serviceType        String              @map("service_type")
  frequency          RecurrenceFrequency
  startDate          DateTime            @map("start_date")
  endDate            DateTime?           @map("end_date")
  maxOccurrences     Int?                @map("max_occurrences")
  localStartHour     Int                 @map("local_start_hour")
  localStartMinute   Int                 @map("local_start_minute")
  durationMinutes    Int                 @map("duration_minutes")
  timezone           String              @default("UTC")
  status             SeriesStatus        @default(ACTIVE)
  cancellationReason String?             @map("cancellation_reason")
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  exceptions   RecurrenceException[] @relation("SeriesToExceptions")
  appointments Appointment[]         @relation("SeriesToAppointments")

  @@index([clientId])
  @@index([therapistId])
  @@index([roomId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("recurrence_series")
}

model RecurrenceException {
  id              String        @id @default(uuid())
  seriesId        String        @map("series_id")
  occurrenceIndex Int           @map("occurrence_index")
  date            DateTime      @map("date")
  type            ExceptionType @default(SKIPPED)
  reason          String?       @map("reason")
  createdAt       DateTime      @default(now()) @map("created_at")

  series RecurrenceSeries @relation("SeriesToExceptions", fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, occurrenceIndex], name: "unique_series_occurrence_exception")
  @@index([seriesId])
  @@map("recurrence_exceptions")
}

model Appointment {
  id                   String            @id @default(uuid())
  clientId             String            @map("client_id")
  therapistId          String            @map("therapist_id")
  roomId               String            @map("room_id")
  type                 String            @map("type")
  status               AppointmentStatus @default(SCHEDULED)
  startTime            DateTime          @map("start_time")
  endTime              DateTime          @map("end_time")
  seriesId             String?           @map("series_id")
  occurrenceIndex      Int?              @map("occurrence_index")
  isDetachedFromSeries Boolean           @default(false) @map("is_detached_from_series")
  cancellationReason   String?           @map("cancellation_reason")
  version              Int               @default(1)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  series RecurrenceSeries? @relation("SeriesToAppointments", fields: [seriesId], references: [id], onDelete: SetNull)
  notes  AppointmentNote[] @relation("AppointmentToNotes")

  @@unique([seriesId, occurrenceIndex], name: "unique_series_occurrence_appointment")
  @@index([clientId, startTime, endTime])
  @@index([therapistId, startTime, endTime])
  @@index([roomId, startTime, endTime])
  @@index([seriesId])
  @@index([status])
  @@index([startTime, endTime])
  @@map("appointments")
}

model AppointmentNote {
  id            String   @id @default(uuid())
  appointmentId String   @map("appointment_id")
  authorId      String   @map("author_id")
  noteText      String   @map("note_text")
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation("AppointmentToNotes", fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_notes")
}

model Room {
  id                String       @id @default(uuid())
  name              String
  capacity          Int          @default(1)
  status            RoomStatus   @default(AVAILABLE)
  resourceType      ResourceType @default(ROOM) @map("resource_type")
  features          String[]     @default([])
  maintenanceReason String?      @map("maintenance_reason")
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  maintenanceWindows MaintenanceWindow[] @relation("RoomToMaintenanceWindows")

  @@index([status])
  @@index([name])
  @@index([resourceType])
  @@map("rooms")
}

model MaintenanceWindow {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  reason    String?  @map("reason")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room Room @relation("RoomToMaintenanceWindows", fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startTime, endTime])
  @@index([startTime, endTime])
  @@map("maintenance_windows")
}

// ==========================================
// KINESIOLOGY BOUNDED CONTEXT
// ==========================================

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model TreatmentSession {
  id                 String        @id @default(uuid())
  clientId           String        @map("client_id")
  therapistId        String        @map("therapist_id")
  appointmentId      String        @unique @map("appointment_id")
  status             SessionStatus @default(SCHEDULED)
  cancellationReason String?       @map("cancellation_reason")
  notesSubjective    String?       @map("notes_subjective")
  notesObjective     String?       @map("notes_objective")
  notesAssessment    String?       @map("notes_assessment")
  notesPlan          String?       @map("notes_plan")
  notesRawText       String?       @map("notes_raw_text")
  version            Int           @default(1)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([clientId, createdAt(sort: Desc)])
  @@index([therapistId])
  @@index([status])
  @@index([appointmentId])
  @@map("treatment_sessions")
}

// ==========================================
// GYM MANAGEMENT BOUNDED CONTEXT (PHASE 5)
// ==========================================

enum MembershipStatus {
  PENDING
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
  TERMINATED
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CheckInMethod {
  QR_CODE
  BARCODE
  RFID
  MANUAL_RECEPTION
  BIOMETRIC
}

enum AccessResult {
  GRANTED
  DENIED_NO_MEMBERSHIP
  DENIED_EXPIRED
  DENIED_FROZEN
  DENIED_INACTIVE_CLIENT
  DENIED_OUT_OF_HOURS
  DENIED_FACILITY_MISMATCH
  DENIED_DUPLICATE_CHECKIN
  DENIED_QUOTA_EXCEEDED
  DENIED_SYSTEM_ERROR
}

model MembershipPlan {
  id            String     @id @default(uuid())
  code          String     @unique
  name          String
  description   String?
  durationDays  Int        @map("duration_days")
  priceAmount   Decimal    @map("price_amount") @db.Decimal(10, 2)
  priceCurrency String     @default("USD") @map("price_currency")
  visitQuota    Int?       @map("visit_quota")
  status        PlanStatus @default(DRAFT)
  version       Int        @default(1)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  memberships Membership[] @relation("PlanToMemberships")

  @@index([code])
  @@index([status])
  @@map("membership_plans")
}

model Membership {
  id                 String           @id @default(uuid())
  clientId           String           @map("client_id")
  planId             String           @map("plan_id")
  status             MembershipStatus @default(ACTIVE)
  startDate          DateTime         @map("start_date")
  endDate            DateTime         @map("end_date")
  assignedTrainerId  String?          @map("assigned_trainer_id")
  freezeHistory      Json             @default("[]") @map("freeze_history")
  cancellationReason String?          @map("cancellation_reason")
  terminationReason  String?          @map("termination_reason")
  version            Int              @default(1)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  plan              MembershipPlan     @relation("PlanToMemberships", fields: [planId], references: [id], onDelete: Restrict)
  attendanceRecords AttendanceRecord[] @relation("MembershipToAttendance")

  @@index([clientId, status])
  @@index([planId])
  @@index([status, endDate])
  @@index([assignedTrainerId])
  @@map("memberships")
}

model AttendanceRecord {
  id             String        @id @default(uuid())
  clientId       String        @map("client_id")
  membershipId   String?       @map("membership_id")
  checkInTime    DateTime      @map("check_in_time")
  gymDay         String        @map("gym_day")
  method         CheckInMethod
  result         AccessResult
  gateId         String?       @map("gate_id")
  receptionistId String?       @map("receptionist_id")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")

  membership Membership? @relation("MembershipToAttendance", fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([clientId, checkInTime(sort: Desc)])
  @@index([gymDay])
  @@index([membershipId])
  @@index([result])
  @@map("attendance_records")
}

// ============================================================================
// PHASE 6: RESOURCES MANAGEMENT (CONSUMABLE INVENTORY & FIXED ASSETS)
// ============================================================================

enum InventoryItemStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StockMovementType {
  PURCHASE
  SALE
  CONSUMPTION
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  CORRECTION
  SCRAP
}

enum UnitOfMeasure {
  UNITS
  BOXES
  BOTTLES
  ROLLS
  MILLILITERS
  GRAMS
}

enum InventoryCategory {
  HEALTHY_MEALS
  HEALTHY_DRINKS
  CLEANING_SUPPLIES
  OFFICE_SUPPLIES
  SUPPLEMENTS
  CLINICAL_SUPPLIES
  THERAPY_CONSUMABLES
  RETAIL_PRODUCTS
}

model InventoryItem {
  id                   String              @id @default(uuid())
  tenantId             String?             @map("tenant_id")
  sku                  String              @unique
  name                 String
  description          String?
  category             InventoryCategory   @default(CLINICAL_SUPPLIES)
  unit                 UnitOfMeasure       @default(UNITS)
  minimumStock         Decimal             @default(0) @map("minimum_stock") @db.Decimal(10, 2)
  quantityOnHand       Decimal             @default(0) @map("quantity_on_hand") @db.Decimal(10, 2)
  purchaseCostAmount   Decimal             @default(0) @map("purchase_cost_amount") @db.Decimal(10, 2)
  purchaseCostCurrency String              @default("USD") @map("purchase_cost_currency")
  sellingPriceAmount   Decimal             @default(0) @map("selling_price_amount") @db.Decimal(10, 2)
  sellingPriceCurrency String              @default("USD") @map("selling_price_currency")
  status               InventoryItemStatus @default(ACTIVE)
  locationRef          Json?               @map("location_ref")
  version              Int                 @default(1)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  movements StockMovement[] @relation("ItemToStockMovements")

  @@index([sku])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([status])
  @@index([category])
  @@index([quantityOnHand])
  @@map("inventory_items")
}

model StockMovement {
  id               String            @id @default(uuid())
  inventoryItemId  String            @map("inventory_item_id")
  movementType     StockMovementType @map("movement_type")
  quantityDelta    Decimal           @map("quantity_delta") @db.Decimal(10, 2)
  balanceAfter     Decimal           @map("balance_after") @db.Decimal(10, 2)
  unitCostAmount   Decimal           @default(0) @map("unit_cost_amount") @db.Decimal(10, 2)
  unitCostCurrency String            @default("USD") @map("unit_cost_currency")
  reason           String
  recordedByUserId String            @map("recorded_by_user_id")
  referenceId      String?           @map("reference_id")
  recordedAt       DateTime          @default(now()) @map("recorded_at")

  item InventoryItem @relation("ItemToStockMovements", fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, recordedAt(sort: Desc)])
  @@index([recordedByUserId])
  @@index([movementType])
  @@index([referenceId])
  @@map("stock_movements")
}

enum AssetCategory {
  GYM_EQUIPMENT
  THERAPY_EQUIPMENT
  KITCHEN_EQUIPMENT
  OFFICE_FURNITURE
  ELECTRONICS
  CLEANING_EQUIPMENT
}

enum AssetStatus {
  ACTIVE
  UNDER_MAINTENANCE
  DAMAGED
  RETIRED
  SOLD
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  NEEDS_REPAIR
  OUT_OF_SERVICE
}

enum AssetHistoryEventType {
  CREATED
  UPDATED
  TRANSFERRED
  STATUS_CHANGED
  CONDITION_CHANGED
  VALUE_UPDATED
  MAINTENANCE_RECORDED
  RETIRED
  SOLD
}

model FixedAsset {
  id                            String         @id @default(uuid())
  tenantId                      String?        @map("tenant_id")
  assetTag                      String         @unique @map("asset_tag")
  name                          String
  description                   String?
  category                      AssetCategory
  purchaseDate                  DateTime       @map("purchase_date")
  purchaseValueAmount           Decimal        @map("purchase_value_amount") @db.Decimal(10, 2)
  purchaseValueCurrency         String         @default("USD") @map("purchase_value_currency")
  currentEstimatedValueAmount   Decimal        @map("current_estimated_value_amount") @db.Decimal(10, 2)
  currentEstimatedValueCurrency String         @default("USD") @map("current_estimated_value_currency")
  condition                     AssetCondition @default(EXCELLENT)
  status                        AssetStatus    @default(ACTIVE)
  location                      Json           @map("location")
  notes                         String?
  version                       Int            @default(1)
  createdAt                     DateTime       @default(now()) @map("created_at")
  updatedAt                     DateTime       @updatedAt @map("updated_at")

  historyEvents      AssetHistoryEvent[]      @relation("AssetToHistoryEvents")
  maintenanceRecords AssetMaintenanceRecord[] @relation("AssetToMaintenanceRecords")

  @@index([assetTag])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([status])
  @@index([category])
  @@index([condition])
  @@map("fixed_assets")
}

model AssetHistoryEvent {
  id               String                @id @default(uuid())
  assetId          String                @map("asset_id")
  eventType        AssetHistoryEventType @map("event_type")
  description      String
  details          Json?                 @map("details")
  recordedByUserId String                @map("recorded_by_user_id")
  recordedAt       DateTime              @default(now()) @map("recorded_at")

  asset FixedAsset @relation("AssetToHistoryEvents", fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId, recordedAt(sort: Desc)])
  @@index([eventType])
  @@index([recordedByUserId])
  @@map("asset_history_events")
}

model AssetMaintenanceRecord {
  id               String   @id @default(uuid())
  assetId          String   @map("asset_id")
  serviceDate      DateTime @map("service_date")
  description      String
  costAmount       Decimal  @default(0) @map("cost_amount") @db.Decimal(10, 2)
  costCurrency     String   @default("USD") @map("cost_currency")
  performedBy      String   @map("performed_by")
  notes            String?
  recordedByUserId String   @map("recorded_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  asset FixedAsset @relation("AssetToMaintenanceRecords", fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId, serviceDate(sort: Desc)])
  @@index([recordedByUserId])
  @@map("asset_maintenance_records")
}

// ============================================================================
// PHASE 7: SALES & PAYMENTS
// ============================================================================

enum SaleStatus {
  DRAFT
  PENDING_PAYMENT
  PARTIALLY_PAID
  PAID
  COMPLETED
  CANCELLED
  REFUNDED
}

model Sale {
  id                  String     @id @default(uuid())
  tenantId            String?    @map("tenant_id")
  clientId            String?    @map("client_id")
  status              SaleStatus @default(DRAFT)
  currency            String     @default("USD") @db.VarChar(3)
  sourceType          String     @map("source_type")
  sourceId            String     @map("source_id")
  sourceCode          String?    @map("source_code")
  subtotalAmount      Decimal    @map("subtotal_amount") @db.Decimal(12, 2)
  discountTotalAmount Decimal    @map("discount_total_amount") @db.Decimal(12, 2)
  totalAmount         Decimal    @map("total_amount") @db.Decimal(12, 2)
  orderDiscountType   String?    @map("order_discount_type")
  orderDiscountValue  Decimal?   @map("order_discount_value") @db.Decimal(10, 2)
  orderDiscountReason String?    @map("order_discount_reason")
  cancellationReason  String?    @map("cancellation_reason")
  cancelledAt         DateTime?  @map("cancelled_at")
  completedAt         DateTime?  @map("completed_at")
  refundedAt          DateTime?  @map("refunded_at")
  version             Int        @default(1)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  items    SaleItem[] @relation("SaleToSaleItems")
  payments Payment[]  @relation("SaleToPayments")

  @@index([tenantId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("sales")
}

model SaleItem {
  id                  String   @id @default(uuid())
  saleId              String   @map("sale_id")
  sourceType          String   @map("source_type")
  sourceId            String   @map("source_id")
  sourceCode          String?  @map("source_code")
  description         String
  skuOrCode           String?  @map("sku_or_code")
  quantity            Decimal  @db.Decimal(10, 3)
  unitPriceAmount     Decimal  @map("unit_price_amount") @db.Decimal(12, 2)
  unitPriceCurrency   String   @default("USD") @map("unit_price_currency") @db.VarChar(3)
  subtotalAmount      Decimal  @map("subtotal_amount") @db.Decimal(12, 2)
  discountTotalAmount Decimal  @map("discount_total_amount") @db.Decimal(12, 2)
  totalAmount         Decimal  @map("total_amount") @db.Decimal(12, 2)
  discountType        String?  @map("discount_type")
  discountValue       Decimal? @map("discount_value") @db.Decimal(10, 2)
  discountReason      String?  @map("discount_reason")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  sale Sale @relation("SaleToSaleItems", fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([skuOrCode])
  @@map("sale_items")
}

enum PaymentMethod {
  CASH
  QR
}

enum PaymentStatus {
  PENDING
  SETTLED
  FAILED
  CANCELLED
}

model Payment {
  id        String        @id @default(uuid())
  tenantId  String?       @map("tenant_id")
  saleId    String        @map("sale_id")
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @default("USD") @db.VarChar(3)
  status    PaymentStatus @default(SETTLED)
  reference String?       @db.VarChar(100)
  paidAt    DateTime?     @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  version   Int           @default(1)

  sale Sale @relation("SaleToPayments", fields: [saleId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, saleId])
  @@index([tenantId, status])
  @@index([saleId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("payments")
}
