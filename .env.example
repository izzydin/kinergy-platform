# ==============================================================================
# Kinergy Platform - Environment Configuration Reference
# ==============================================================================

# Application Execution Environment ('development' | 'test' | 'production')
NODE_ENV=development

# HTTP Web Server Port (Range: 1000 - 65535)
PORT=3000

# Global API Route Prefix
API_PREFIX=api/v1

# PostgreSQL Database Connection URI
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kinergy_db?schema=public

# Allowed CORS Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:4200

# OpenAPI Swagger Documentation UI Toggle ('true' | 'false')
SWAGGER_ENABLED=true

# Database Connection Pool Maximum Connections
DATABASE_MAX_CONNECTIONS=10

# Database SSL Connection Toggle ('true' | 'false')
DATABASE_SSL=false
