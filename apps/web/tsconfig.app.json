{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@app/*": ["src/app/*"],
      "@modules/*": ["src/modules/*"],
      "@shared/*": ["src/shared/*"],
      "@kinergy-platform/ui": ["../../packages/ui/src/index.ts"],
      "@kinergy-platform/types": ["../../packages/types/src/index.ts"],
      "@kinergy-platform/utils": ["../../packages/utils/src/index.ts"],
      "@kinergy-platform/config": ["../../packages/config/src/index.ts"],
      "@kinergy-platform/validation": ["../../packages/validation/src/index.ts"],
      "@kinergy-platform/testing": ["../../packages/testing/src/index.ts"],
      "@kinergy-platform/core": ["../../packages/core/src/index.ts"],
      "@kinergy-platform/client-domain": ["../../modules/client/index.ts"]
    }
  },
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx"],
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
