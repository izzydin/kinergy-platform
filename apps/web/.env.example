# ==============================================================================
# Kinergy Platform - Web Client Environment Reference (.env.example)
# Application: @kinergy-platform/web (apps/web)
# ==============================================================================

# Backend REST API base URL
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Application branding title
VITE_APP_TITLE=Kinergy Platform

# Client-side Telemetry / Analytics toggle ('true' | 'false')
VITE_ENABLE_TELEMETRY=false
