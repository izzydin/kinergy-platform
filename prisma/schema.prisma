// Kinergy Platform - Prisma Database Schema
// Bounded Context: Identity & Access Management (IAM)
// Datasource: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  LOCKED
  SUSPENDED
  DEACTIVATED
}

enum RoleType {
  SYSTEM
  CUSTOM
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(PENDING_ACTIVATION)
  roleId       String     @map("role_id")
  tenantId     String?    @map("tenant_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  role Role @relation("UserToRole", fields: [roleId], references: [id], onDelete: Restrict)

  refreshTokens RefreshToken[] @relation("UserToRefreshTokens")

  @@index([email])
  @@index([roleId])
  @@index([status])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  familyId  String   @map("family_id")
  userId    String   @map("user_id")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation("UserToRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  type        RoleType @default(CUSTOM)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]           @relation("UserToRole")
  permissions RolePermission[] @relation("RoleToRolePermissions")

  @@index([name])
  @@index([type])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[] @relation("PermissionToRolePermissions")

  @@index([code])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role       Role       @relation("RoleToRolePermissions", fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation("PermissionToRolePermissions", fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], name: "unique_role_permission")
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ==========================================
// CLIENT BOUNDED CONTEXT
// ==========================================

model Client {
  id                   String   @id @default(uuid())
  referenceNumber      String   @unique @map("reference_number")
  identityId           String?  @unique @map("identity_id")
  firstName            String   @map("first_name")
  lastName             String   @map("last_name")
  email                String   @map("email")
  phone                String   @map("phone")
  normalizedEmail      String   @map("normalized_email")
  normalizedPhone      String   @map("normalized_phone")
  normalizedSearchName String   @map("normalized_search_name")
  status               String   @default("ACTIVE") @map("status")
  version              Int      @default(1) @map("version")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  timelineEntries ClientTimelineEntry[] @relation("ClientToTimeline")

  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([normalizedSearchName])
  @@index([status])
  @@map("clients")
}

model ClientTimelineEntry {
  id           String   @id @default(uuid())
  clientId     String   @map("client_id")
  sourceModule String   @map("source_module")
  eventType    String   @map("event_type")
  summary      String
  metadata     Json     @default("{}")
  occurredAt   DateTime @map("occurred_at")
  createdAt    DateTime @default(now()) @map("created_at")

  client Client @relation("ClientToTimeline", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, occurredAt(sort: Desc)])
  @@index([eventType])
  @@map("client_timeline_entries")
}

// ==========================================
// SCHEDULING BOUNDED CONTEXT
// ==========================================

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum SeriesStatus {
  ACTIVE
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum ExceptionType {
  SKIPPED
  MODIFIED
}

enum RoomStatus {
  AVAILABLE
  UNAVAILABLE
  MAINTENANCE
}

enum ResourceType {
  ROOM
  EQUIPMENT
  THERAPY_BED
  RENTAL_FACILITY
}

model RecurrenceSeries {
  id                 String              @id @default(uuid())
  clientId           String              @map("client_id")
  therapistId        String              @map("therapist_id")
  roomId             String              @map("room_id")
  serviceType        String              @map("service_type")
  frequency          RecurrenceFrequency
  startDate          DateTime            @map("start_date")
  endDate            DateTime?           @map("end_date")
  maxOccurrences     Int?                @map("max_occurrences")
  localStartHour     Int                 @map("local_start_hour")
  localStartMinute   Int                 @map("local_start_minute")
  durationMinutes    Int                 @map("duration_minutes")
  timezone           String              @default("UTC")
  status             SeriesStatus        @default(ACTIVE)
  cancellationReason String?             @map("cancellation_reason")
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  exceptions   RecurrenceException[] @relation("SeriesToExceptions")
  appointments Appointment[]         @relation("SeriesToAppointments")

  @@index([clientId])
  @@index([therapistId])
  @@index([roomId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("recurrence_series")
}

model RecurrenceException {
  id              String        @id @default(uuid())
  seriesId        String        @map("series_id")
  occurrenceIndex Int           @map("occurrence_index")
  date            DateTime      @map("date")
  type            ExceptionType @default(SKIPPED)
  reason          String?       @map("reason")
  createdAt       DateTime      @default(now()) @map("created_at")

  series RecurrenceSeries @relation("SeriesToExceptions", fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, occurrenceIndex], name: "unique_series_occurrence_exception")
  @@index([seriesId])
  @@map("recurrence_exceptions")
}

model Appointment {
  id                   String            @id @default(uuid())
  clientId             String            @map("client_id")
  therapistId          String            @map("therapist_id")
  roomId               String            @map("room_id")
  type                 String            @map("type")
  status               AppointmentStatus @default(SCHEDULED)
  startTime            DateTime          @map("start_time")
  endTime              DateTime          @map("end_time")
  seriesId             String?           @map("series_id")
  occurrenceIndex      Int?              @map("occurrence_index")
  isDetachedFromSeries Boolean           @default(false) @map("is_detached_from_series")
  cancellationReason   String?           @map("cancellation_reason")
  version              Int               @default(1)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  series RecurrenceSeries? @relation("SeriesToAppointments", fields: [seriesId], references: [id], onDelete: SetNull)
  notes  AppointmentNote[] @relation("AppointmentToNotes")

  @@unique([seriesId, occurrenceIndex], name: "unique_series_occurrence_appointment")
  @@index([clientId, startTime, endTime])
  @@index([therapistId, startTime, endTime])
  @@index([roomId, startTime, endTime])
  @@index([seriesId])
  @@index([status])
  @@index([startTime, endTime])
  @@map("appointments")
}

model AppointmentNote {
  id            String   @id @default(uuid())
  appointmentId String   @map("appointment_id")
  authorId      String   @map("author_id")
  noteText      String   @map("note_text")
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation("AppointmentToNotes", fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_notes")
}

model Room {
  id                String       @id @default(uuid())
  name              String
  capacity          Int          @default(1)
  status            RoomStatus   @default(AVAILABLE)
  resourceType      ResourceType @default(ROOM) @map("resource_type")
  features          String[]     @default([])
  maintenanceReason String?      @map("maintenance_reason")
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  maintenanceWindows MaintenanceWindow[] @relation("RoomToMaintenanceWindows")

  @@index([status])
  @@index([name])
  @@index([resourceType])
  @@map("rooms")
}

model MaintenanceWindow {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  reason    String?  @map("reason")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room Room @relation("RoomToMaintenanceWindows", fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startTime, endTime])
  @@index([startTime, endTime])
  @@map("maintenance_windows")
}

// ==========================================
// KINESIOLOGY BOUNDED CONTEXT
// ==========================================

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model TreatmentSession {
  id                 String        @id @default(uuid())
  clientId           String        @map("client_id")
  therapistId        String        @map("therapist_id")
  appointmentId      String        @unique @map("appointment_id")
  status             SessionStatus @default(SCHEDULED)
  cancellationReason String?       @map("cancellation_reason")
  notesSubjective    String?       @map("notes_subjective")
  notesObjective     String?       @map("notes_objective")
  notesAssessment    String?       @map("notes_assessment")
  notesPlan          String?       @map("notes_plan")
  notesRawText       String?       @map("notes_raw_text")
  version            Int           @default(1)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([clientId, createdAt(sort: Desc)])
  @@index([therapistId])
  @@index([status])
  @@index([appointmentId])
  @@map("treatment_sessions")
}

// ==========================================
// GYM MANAGEMENT BOUNDED CONTEXT (PHASE 5)
// ==========================================

enum MembershipStatus {
  PENDING
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
  TERMINATED
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CheckInMethod {
  QR_CODE
  BARCODE
  RFID
  MANUAL_RECEPTION
  BIOMETRIC
}

enum AccessResult {
  GRANTED
  DENIED_NO_MEMBERSHIP
  DENIED_EXPIRED
  DENIED_FROZEN
  DENIED_INACTIVE_CLIENT
  DENIED_OUT_OF_HOURS
  DENIED_FACILITY_MISMATCH
  DENIED_DUPLICATE_CHECKIN
  DENIED_QUOTA_EXCEEDED
  DENIED_SYSTEM_ERROR
}

model MembershipPlan {
  id            String     @id @default(uuid())
  code          String     @unique
  name          String
  description   String?
  durationDays  Int        @map("duration_days")
  priceAmount   Decimal    @map("price_amount") @db.Decimal(10, 2)
  priceCurrency String     @default("USD") @map("price_currency")
  visitQuota    Int?       @map("visit_quota")
  status        PlanStatus @default(DRAFT)
  version       Int        @default(1)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  memberships Membership[] @relation("PlanToMemberships")

  @@index([code])
  @@index([status])
  @@map("membership_plans")
}

model Membership {
  id                 String           @id @default(uuid())
  clientId           String           @map("client_id")
  planId             String           @map("plan_id")
  status             MembershipStatus @default(ACTIVE)
  startDate          DateTime         @map("start_date")
  endDate            DateTime         @map("end_date")
  assignedTrainerId  String?          @map("assigned_trainer_id")
  freezeHistory      Json             @default("[]") @map("freeze_history")
  cancellationReason String?          @map("cancellation_reason")
  terminationReason  String?          @map("termination_reason")
  version            Int              @default(1)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  plan              MembershipPlan     @relation("PlanToMemberships", fields: [planId], references: [id], onDelete: Restrict)
  attendanceRecords AttendanceRecord[] @relation("MembershipToAttendance")

  @@index([clientId, status])
  @@index([planId])
  @@index([status, endDate])
  @@index([assignedTrainerId])
  @@map("memberships")
}

model AttendanceRecord {
  id             String        @id @default(uuid())
  clientId       String        @map("client_id")
  membershipId   String?       @map("membership_id")
  checkInTime    DateTime      @map("check_in_time")
  gymDay         String        @map("gym_day")
  method         CheckInMethod
  result         AccessResult
  gateId         String?       @map("gate_id")
  receptionistId String?       @map("receptionist_id")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")

  membership Membership? @relation("MembershipToAttendance", fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([clientId, checkInTime(sort: Desc)])
  @@index([gymDay])
  @@index([membershipId])
  @@index([result])
  @@map("attendance_records")
}

// ============================================================================
// PHASE 6: RESOURCES MANAGEMENT (CONSUMABLE INVENTORY & FIXED ASSETS)
// ============================================================================

enum InventoryItemStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StockMovementType {
  PURCHASE
  SALE
  CONSUMPTION
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  CORRECTION
  SCRAP
}

enum UnitOfMeasure {
  UNITS
  BOXES
  BOTTLES
  ROLLS
  MILLILITERS
  GRAMS
}

enum InventoryCategory {
  HEALTHY_MEALS
  HEALTHY_DRINKS
  CLEANING_SUPPLIES
  OFFICE_SUPPLIES
  SUPPLEMENTS
  CLINICAL_SUPPLIES
  THERAPY_CONSUMABLES
  RETAIL_PRODUCTS
}

model InventoryItem {
  id                   String              @id @default(uuid())
  tenantId             String?             @map("tenant_id")
  sku                  String              @unique
  name                 String
  description          String?
  category             InventoryCategory   @default(CLINICAL_SUPPLIES)
  unit                 UnitOfMeasure       @default(UNITS)
  minimumStock         Decimal             @default(0) @map("minimum_stock") @db.Decimal(10, 2)
  quantityOnHand       Decimal             @default(0) @map("quantity_on_hand") @db.Decimal(10, 2)
  purchaseCostAmount   Decimal             @default(0) @map("purchase_cost_amount") @db.Decimal(10, 2)
  purchaseCostCurrency String              @default("USD") @map("purchase_cost_currency")
  sellingPriceAmount   Decimal             @default(0) @map("selling_price_amount") @db.Decimal(10, 2)
  sellingPriceCurrency String              @default("USD") @map("selling_price_currency")
  status               InventoryItemStatus @default(ACTIVE)
  locationRef          Json?               @map("location_ref")
  version              Int                 @default(1)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  movements StockMovement[] @relation("ItemToStockMovements")

  @@index([sku])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([status])
  @@index([category])
  @@index([quantityOnHand])
  @@map("inventory_items")
}

model StockMovement {
  id               String            @id @default(uuid())
  inventoryItemId  String            @map("inventory_item_id")
  movementType     StockMovementType @map("movement_type")
  quantityDelta    Decimal           @map("quantity_delta") @db.Decimal(10, 2)
  balanceAfter     Decimal           @map("balance_after") @db.Decimal(10, 2)
  unitCostAmount   Decimal           @default(0) @map("unit_cost_amount") @db.Decimal(10, 2)
  unitCostCurrency String            @default("USD") @map("unit_cost_currency")
  reason           String
  recordedByUserId String            @map("recorded_by_user_id")
  referenceId      String?           @map("reference_id")
  recordedAt       DateTime          @default(now()) @map("recorded_at")

  item InventoryItem @relation("ItemToStockMovements", fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, recordedAt(sort: Desc)])
  @@index([recordedByUserId])
  @@index([movementType])
  @@index([referenceId])
  @@map("stock_movements")
}

enum AssetCategory {
  GYM_EQUIPMENT
  THERAPY_EQUIPMENT
  KITCHEN_EQUIPMENT
  OFFICE_FURNITURE
  ELECTRONICS
  CLEANING_EQUIPMENT
}

enum AssetStatus {
  ACTIVE
  UNDER_MAINTENANCE
  DAMAGED
  RETIRED
  SOLD
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  NEEDS_REPAIR
  OUT_OF_SERVICE
}

enum AssetHistoryEventType {
  CREATED
  UPDATED
  TRANSFERRED
  STATUS_CHANGED
  CONDITION_CHANGED
  VALUE_UPDATED
  MAINTENANCE_RECORDED
  RETIRED
  SOLD
}

model FixedAsset {
  id                            String         @id @default(uuid())
  tenantId                      String?        @map("tenant_id")
  assetTag                      String         @unique @map("asset_tag")
  name                          String
  description                   String?
  category                      AssetCategory
  purchaseDate                  DateTime       @map("purchase_date")
  purchaseValueAmount           Decimal        @map("purchase_value_amount") @db.Decimal(10, 2)
  purchaseValueCurrency         String         @default("USD") @map("purchase_value_currency")
  currentEstimatedValueAmount   Decimal        @map("current_estimated_value_amount") @db.Decimal(10, 2)
  currentEstimatedValueCurrency String         @default("USD") @map("current_estimated_value_currency")
  condition                     AssetCondition @default(EXCELLENT)
  status                        AssetStatus    @default(ACTIVE)
  location                      Json           @map("location")
  notes                         String?
  version                       Int            @default(1)
  createdAt                     DateTime       @default(now()) @map("created_at")
  updatedAt                     DateTime       @updatedAt @map("updated_at")

  historyEvents      AssetHistoryEvent[]      @relation("AssetToHistoryEvents")
  maintenanceRecords AssetMaintenanceRecord[] @relation("AssetToMaintenanceRecords")

  @@index([assetTag])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([status])
  @@index([category])
  @@index([condition])
  @@map("fixed_assets")
}

model AssetHistoryEvent {
  id               String                @id @default(uuid())
  assetId          String                @map("asset_id")
  eventType        AssetHistoryEventType @map("event_type")
  description      String
  details          Json?                 @map("details")
  recordedByUserId String                @map("recorded_by_user_id")
  recordedAt       DateTime              @default(now()) @map("recorded_at")

  asset FixedAsset @relation("AssetToHistoryEvents", fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId, recordedAt(sort: Desc)])
  @@index([eventType])
  @@index([recordedByUserId])
  @@map("asset_history_events")
}

model AssetMaintenanceRecord {
  id               String   @id @default(uuid())
  assetId          String   @map("asset_id")
  serviceDate      DateTime @map("service_date")
  description      String
  costAmount       Decimal  @default(0) @map("cost_amount") @db.Decimal(10, 2)
  costCurrency     String   @default("USD") @map("cost_currency")
  performedBy      String   @map("performed_by")
  notes            String?
  recordedByUserId String   @map("recorded_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  asset FixedAsset @relation("AssetToMaintenanceRecords", fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId, serviceDate(sort: Desc)])
  @@index([recordedByUserId])
  @@map("asset_maintenance_records")
}

// ============================================================================
// PHASE 7: SALES & PAYMENTS
// ============================================================================

enum SaleStatus {
  DRAFT
  PENDING_PAYMENT
  PARTIALLY_PAID
  PAID
  COMPLETED
  CANCELLED
  REFUNDED
}

model Sale {
  id                  String     @id @default(uuid())
  tenantId            String?    @map("tenant_id")
  clientId            String?    @map("client_id")
  status              SaleStatus @default(DRAFT)
  currency            String     @default("USD") @db.VarChar(3)
  sourceType          String     @map("source_type")
  sourceId            String     @map("source_id")
  sourceCode          String?    @map("source_code")
  subtotalAmount      Decimal    @map("subtotal_amount") @db.Decimal(12, 2)
  discountTotalAmount Decimal    @map("discount_total_amount") @db.Decimal(12, 2)
  totalAmount         Decimal    @map("total_amount") @db.Decimal(12, 2)
  orderDiscountType   String?    @map("order_discount_type")
  orderDiscountValue  Decimal?   @map("order_discount_value") @db.Decimal(10, 2)
  orderDiscountReason String?    @map("order_discount_reason")
  cancellationReason  String?    @map("cancellation_reason")
  cancelledAt         DateTime?  @map("cancelled_at")
  completedAt         DateTime?  @map("completed_at")
  refundedAt          DateTime?  @map("refunded_at")
  version             Int        @default(1)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  items    SaleItem[] @relation("SaleToSaleItems")
  payments Payment[]  @relation("SaleToPayments")
  receipts Receipt[]  @relation("SaleToReceipts")

  @@index([tenantId])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([tenantId, sourceType, sourceId])
  @@index([sourceType, sourceId])
  @@map("sales")
}

model SaleItem {
  id                  String   @id @default(uuid())
  saleId              String   @map("sale_id")
  sourceType          String   @map("source_type")
  sourceId            String   @map("source_id")
  sourceCode          String?  @map("source_code")
  description         String
  skuOrCode           String?  @map("sku_or_code")
  quantity            Decimal  @db.Decimal(10, 3)
  unitPriceAmount     Decimal  @map("unit_price_amount") @db.Decimal(12, 2)
  unitPriceCurrency   String   @default("USD") @map("unit_price_currency") @db.VarChar(3)
  subtotalAmount      Decimal  @map("subtotal_amount") @db.Decimal(12, 2)
  discountTotalAmount Decimal  @map("discount_total_amount") @db.Decimal(12, 2)
  totalAmount         Decimal  @map("total_amount") @db.Decimal(12, 2)
  discountType        String?  @map("discount_type")
  discountValue       Decimal? @map("discount_value") @db.Decimal(10, 2)
  discountReason      String?  @map("discount_reason")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  sale Sale @relation("SaleToSaleItems", fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([skuOrCode])
  @@index([sourceType, sourceId])
  @@map("sale_items")
}

enum PaymentMethod {
  CASH
  QR
}

enum PaymentStatus {
  PENDING
  SETTLED
  FAILED
  CANCELLED
}

model Payment {
  id        String        @id @default(uuid())
  tenantId  String?       @map("tenant_id")
  saleId    String        @map("sale_id")
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @default("USD") @db.VarChar(3)
  status    PaymentStatus @default(SETTLED)
  reference String?       @db.VarChar(100)
  paidAt    DateTime?     @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  version   Int           @default(1)

  sale Sale @relation("SaleToPayments", fields: [saleId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, saleId])
  @@index([tenantId, status])
  @@index([saleId, createdAt])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("payments")
}

// ==========================================
// RECEIPT BOUNDED SUBDOMAIN (PHASE 7.7)
// ==========================================

enum ReceiptStatus {
  ISSUED
  REPRINTED
}

model ReceiptSequence {
  tenantId     String   @map("tenant_id")
  year         Int      @map("year")
  currentValue Int      @default(0) @map("current_value")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@id([tenantId, year])
  @@map("receipt_sequences")
}

model Receipt {
  id                  String        @id @default(uuid())
  tenantId            String        @map("tenant_id")
  saleId              String        @map("sale_id")
  receiptNumber       String        @map("receipt_number") @db.VarChar(50)
  saleReference       String        @map("sale_reference") @db.VarChar(100)
  issuedAt            DateTime      @default(now()) @map("issued_at")
  clientSnapshot      Json?         @map("client_snapshot")
  itemsSnapshot       Json          @map("items_snapshot")
  paymentsSnapshot    Json          @map("payments_snapshot")
  subtotalAmount      Decimal       @map("subtotal_amount") @db.Decimal(12, 2)
  discountTotalAmount Decimal       @map("discount_total_amount") @db.Decimal(12, 2)
  totalAmount         Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency            String        @default("USD") @map("currency") @db.VarChar(3)
  status              ReceiptStatus @default(ISSUED)
  reprintCount        Int           @default(0) @map("reprint_count")
  lastReprintedAt     DateTime?     @map("last_reprinted_at")
  version             Int           @default(1)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  sale Sale @relation("SaleToReceipts", fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, saleId], name: "unique_tenant_sale_receipt")
  @@unique([tenantId, receiptNumber], name: "unique_tenant_receipt_number")
  @@index([tenantId])
  @@index([saleId])
  @@index([issuedAt(sort: Desc)])
  @@map("receipts")
}

// ==========================================
// KYNERGY INTELLIGENCE (AI-03 KNOWLEDGE MANAGEMENT)
// ==========================================

enum VisibilityScope {
  ALL_STAFF
  CLINICAL_STAFF
  MANAGEMENT
}

enum IngestionStatus {
  UPLOADED
  VALIDATING
  PROCESSING
  INDEXING
  READY
  FAILED
  CANCELLED
}

model KnowledgeDocument {
  id               String          @id @default(uuid())
  tenantId         String          @map("tenant_id")
  title            String          @map("title") @db.VarChar(255)
  description      String?         @map("description") @db.Text
  uploadedBy       String          @map("uploaded_by")
  visibilityScope  VisibilityScope @default(ALL_STAFF) @map("visibility_scope")
  currentVersionId String?         @map("current_version_id")
  version          Int             @default(1) @map("version")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  versions      DocumentVersion[]   @relation("DocumentToVersions")
  ingestionJobs IngestionJob[]      @relation("DocumentToIngestionJobs")
  chunks        KnowledgeChunk[]    @relation("DocumentToChunks")
  embeddings    DocumentEmbedding[] @relation("DocumentToEmbeddings")

  @@index([tenantId])
  @@index([tenantId, visibilityScope])
  @@index([tenantId, deletedAt])
  @@index([createdAt])
  @@map("knowledge_documents")
}

model DocumentVersion {
  id               String   @id @default(uuid())
  documentId       String   @map("document_id")
  versionNumber    Int      @map("version_number")
  originalFileName String   @map("original_file_name") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(100)
  fileSize         Int      @map("file_size")
  checksum         String   @map("checksum") @db.VarChar(64)
  storageKey       String   @map("storage_key") @db.VarChar(512)
  language         String   @default("es") @map("language") @db.VarChar(10)
  uploadedBy       String   @map("uploaded_by")
  createdAt        DateTime @default(now()) @map("created_at")

  document      KnowledgeDocument   @relation("DocumentToVersions", fields: [documentId], references: [id], onDelete: Cascade)
  ingestionJobs IngestionJob[]      @relation("VersionToIngestionJobs")
  chunks        KnowledgeChunk[]    @relation("VersionToChunks")
  embeddings    DocumentEmbedding[] @relation("VersionToEmbeddings")

  @@unique([documentId, versionNumber], name: "unique_document_version_number")
  @@unique([documentId, checksum], name: "unique_document_checksum")
  @@index([documentId])
  @@index([checksum])
  @@index([createdAt])
  @@map("document_versions")
}

model IngestionJob {
  id                 String          @id @default(uuid())
  tenantId           String          @map("tenant_id")
  documentId         String          @map("document_id")
  documentVersionId  String          @map("document_version_id")
  status             IngestionStatus @default(UPLOADED) @map("status")
  attemptCount       Int             @default(1) @map("attempt_count")
  maxAttempts        Int             @default(3) @map("max_attempts")
  lastErrorCode      String?         @map("last_error_code") @db.VarChar(100)
  lastErrorMessage   String?         @map("last_error_message") @db.Text
  version            Int             @default(1) @map("version")
  createdAt          DateTime        @default(now()) @map("created_at")
  startedAt          DateTime?       @map("started_at")
  completedAt        DateTime?       @map("completed_at")
  nextRetryAt        DateTime?       @map("next_retry_at")
  cancelledAt        DateTime?       @map("cancelled_at")
  cancellationReason String?         @map("cancellation_reason") @db.Text

  document   KnowledgeDocument @relation("DocumentToIngestionJobs", fields: [documentId], references: [id], onDelete: Cascade)
  versionRef DocumentVersion   @relation("VersionToIngestionJobs", fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([documentId])
  @@index([documentVersionId])
  @@index([status])
  @@index([tenantId, status])
  @@index([nextRetryAt])
  @@index([createdAt])
  @@map("ingestion_jobs")
}

model KnowledgeChunk {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  documentId        String   @map("document_id")
  documentVersionId String   @map("document_version_id")
  sequence          Int      @map("sequence")
  content           String   @map("content") @db.Text
  tokenCount        Int      @map("token_count")
  language          String   @default("es") @map("language") @db.VarChar(10)
  provenance        Json     @map("provenance")
  metadata          Json?    @map("metadata")
  checksum          String   @map("checksum") @db.VarChar(64)
  tsv               Unsupported("tsvector")? @map("tsv")
  createdAt         DateTime @default(now()) @map("created_at")

  document   KnowledgeDocument   @relation("DocumentToChunks", fields: [documentId], references: [id], onDelete: Cascade)
  version    DocumentVersion     @relation("VersionToChunks", fields: [documentVersionId], references: [id], onDelete: Cascade)
  embeddings DocumentEmbedding[] @relation("ChunkToEmbeddings")

  @@unique([documentVersionId, sequence], name: "unique_version_chunk_sequence")
  @@index([tenantId])
  @@index([documentId])
  @@index([documentVersionId])
  @@index([createdAt])
  @@map("knowledge_chunks")
}

// ==========================================
// AI-05: VECTOR EMBEDDING & INDEXING ENUMS
// ==========================================

enum EmbeddingType {
  DENSE
  SPARSE
  HYBRID
}

enum NormalizationPolicy {
  UNIT_L2
  NONE
}

enum PoolingStrategy {
  CLS
  MEAN
  LAST_TOKEN
}

enum IndexGenerationStatus {
  DRAFT
  BUILDING
  VALIDATING
  ACTIVE
  RETIRED
  FAILED
  CANCELLED
}

enum VectorIndexingScope {
  DOCUMENT
  DOCUMENT_VERSION
  INDEX_GENERATION
  REINDEX_ALL
}

enum VectorIndexingJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ==========================================
// AI-05: VECTOR EMBEDDING & INDEXING MODELS
// ==========================================

model EmbeddingProfile {
  id                  String              @id @default(uuid())
  profileId           String              @unique @map("profile_id") @db.VarChar(128)
  provider            String              @map("provider") @db.VarChar(64)
  modelName           String              @map("model_name") @db.VarChar(128)
  modelVersion        String              @map("model_version") @db.VarChar(64)
  modelDigest         String              @map("model_digest") @db.VarChar(128)
  dimensions          Int                 @map("dimensions")
  tokenizerIdentity   String              @map("tokenizer_identity") @db.VarChar(128)
  normalizationPolicy NormalizationPolicy @default(UNIT_L2) @map("normalization_policy")
  poolingStrategy     PoolingStrategy     @default(CLS) @map("pooling_strategy")
  embeddingType       EmbeddingType       @default(DENSE) @map("embedding_type")
  createdAt           DateTime            @default(now()) @map("created_at")

  indexGenerations IndexGeneration[]   @relation("ProfileToGenerations")
  embeddings       DocumentEmbedding[] @relation("ProfileToEmbeddings")

  @@index([provider, modelName])
  @@index([modelDigest])
  @@map("embedding_profiles")
}

model IndexGeneration {
  id                 String                @id @default(uuid())
  tenantId           String                @map("tenant_id")
  generationNumber   Int                   @map("generation_number")
  profileId          String                @map("profile_id") @db.VarChar(128)
  status             IndexGenerationStatus @default(DRAFT) @map("status")
  targetChunkCount   Int                   @default(0) @map("target_chunk_count")
  indexedChunkCount  Int                   @default(0) @map("indexed_chunk_count")
  failedChunkCount   Int                   @default(0) @map("failed_chunk_count")
  version            Int                   @default(1) @map("version")
  createdAt          DateTime              @default(now()) @map("created_at")
  startedAt          DateTime?             @map("started_at")
  validatedAt        DateTime?             @map("validated_at")
  activatedAt        DateTime?             @map("activated_at")
  retiredAt          DateTime?             @map("retired_at")
  failedAt           DateTime?             @map("failed_at")
  cancelledAt        DateTime?             @map("cancelled_at")
  errorCode          String?               @map("error_code") @db.VarChar(100)
  failureReason      String?               @map("failure_reason") @db.Text
  cancellationReason String?               @map("cancellation_reason") @db.Text

  profile    EmbeddingProfile    @relation("ProfileToGenerations", fields: [profileId], references: [profileId], onDelete: Restrict)
  embeddings DocumentEmbedding[] @relation("GenerationToEmbeddings")
  jobs       VectorIndexingJob[] @relation("GenerationToIndexingJobs")

  @@unique([tenantId, generationNumber], name: "unique_tenant_generation_number")
  @@index([tenantId])
  @@index([status])
  @@index([tenantId, status])
  @@map("index_generations")
}

model DocumentEmbedding {
  id                 String   @id @default(uuid())
  chunkId            String   @map("chunk_id")
  documentId         String   @map("document_id")
  documentVersionId  String   @map("document_version_id")
  indexGenerationId  String   @map("index_generation_id")
  profileId          String   @map("profile_id") @db.VarChar(128)
  dimensions         Int      @map("dimensions")
  embedding          Unsupported("vector(1024)")
  contentFingerprint String   @map("content_fingerprint") @db.VarChar(64)
  createdAt          DateTime @default(now()) @map("created_at")

  chunk      KnowledgeChunk    @relation("ChunkToEmbeddings", fields: [chunkId], references: [id], onDelete: Cascade)
  document   KnowledgeDocument @relation("DocumentToEmbeddings", fields: [documentId], references: [id], onDelete: Cascade)
  version    DocumentVersion   @relation("VersionToEmbeddings", fields: [documentVersionId], references: [id], onDelete: Cascade)
  generation IndexGeneration   @relation("GenerationToEmbeddings", fields: [indexGenerationId], references: [id], onDelete: Cascade)
  profile    EmbeddingProfile  @relation("ProfileToEmbeddings", fields: [profileId], references: [profileId], onDelete: Restrict)

  @@unique([chunkId, indexGenerationId], name: "unique_chunk_generation_embedding")
  @@index([documentId])
  @@index([documentVersionId])
  @@index([indexGenerationId])
  @@index([profileId])
  @@map("document_embeddings")
}

model VectorIndexingJob {
  id                 String                  @id @default(uuid())
  tenantId           String                  @map("tenant_id")
  scope              VectorIndexingScope     @map("scope")
  scopeId            String                  @map("scope_id")
  generationId       String                  @map("generation_id")
  profileId          String                  @map("profile_id") @db.VarChar(128)
  status             VectorIndexingJobStatus @default(PENDING) @map("status")
  batchSize          Int                     @default(16) @map("batch_size")
  totalChunks        Int                     @default(0) @map("total_chunks")
  processedChunks    Int                     @default(0) @map("processed_chunks")
  failedChunks       Int                     @default(0) @map("failed_chunks")
  currentBatchNumber Int                     @default(0) @map("current_batch_number")
  attemptCount       Int                     @default(0) @map("attempt_count")
  maxAttempts        Int                     @default(3) @map("max_attempts")
  lastErrorCode      String?                 @map("last_error_code") @db.VarChar(100)
  lastErrorMessage   String?                 @map("last_error_message") @db.Text
  createdAt          DateTime                @default(now()) @map("created_at")
  startedAt          DateTime?               @map("started_at")
  completedAt        DateTime?               @map("completed_at")
  failedAt           DateTime?               @map("failed_at")
  cancelledAt        DateTime?               @map("cancelled_at")

  generation IndexGeneration @relation("GenerationToIndexingJobs", fields: [generationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([generationId])
  @@map("vector_indexing_jobs")
}

// ============================================================================
// KYNERGY INTELLIGENCE CONVERSATION PERSISTENCE (AI-09.3)
// ============================================================================

enum ConversationRole {
  USER
  ASSISTANT
  SYSTEM
}

enum GenerationStatus {
  PENDING
  STREAMING
  SUCCESS
  FAILED
  CANCELLED
  INTERRUPTED
}

enum TurnStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
  CANCELLED
  INTERRUPTED
}

model AiConversation {
  id             String    @id @default(uuid()) @map("id")
  tenantId       String    @map("tenant_id")
  userId         String    @map("user_id")
  title          String    @default("New Conversation") @map("title") @db.VarChar(255)
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(64)
  turnCounter    Int       @default(0) @map("turn_counter")
  messageCounter Int       @default(0) @map("message_counter")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  turns    AiConversationTurn[]
  messages AiConversationMessage[]

  @@unique([id, tenantId], name: "uq_conversation_id_tenant")
  @@unique([tenantId, userId, idempotencyKey], name: "uq_conversation_user_idempotency")
  @@index([tenantId, userId, deletedAt, lastActivityAt(sort: Desc)], name: "idx_conversation_user_active_list")
  @@index([tenantId, deletedAt, lastActivityAt(sort: Desc)], name: "idx_conversation_tenant_audit_list")
  @@map("ai_conversations")
}

model AiConversationTurn {
  id                     String     @id @default(uuid()) @map("id")
  conversationId         String     @map("conversation_id")
  tenantId               String     @map("tenant_id")
  turnIndex              Int        @map("turn_index")
  status                 TurnStatus @default(PENDING) @map("status")
  clientTurnId           String     @map("client_turn_id") @db.VarChar(64)
  idempotencyKey         String     @map("idempotency_key") @db.VarChar(64)
  idempotencyPayloadHash String     @map("idempotency_payload_hash") @db.VarChar(64)
  activeAttemptId        String?    @map("active_attempt_id")
  activeAttemptNumber    Int        @default(1) @map("active_attempt_number")
  createdAt              DateTime   @default(now()) @map("created_at")
  completedAt            DateTime?  @map("completed_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  conversation  AiConversation          @relation(fields: [conversationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  messages      AiConversationMessage[] @relation("TurnAllMessages")
  activeAttempt AiConversationMessage?  @relation("TurnActiveAttempt", fields: [activeAttemptId], references: [id], onDelete: SetNull)

  @@unique([id, conversationId, tenantId], name: "uq_turn_id_conv_tenant")
  @@unique([conversationId, turnIndex], name: "uq_conversation_turn_index")
  @@unique([conversationId, idempotencyKey], name: "uq_turn_conv_idempotency")
  @@unique([tenantId, clientTurnId], name: "uq_turn_tenant_client_turn_id")
  @@index([conversationId, status], name: "idx_turn_conversation_status")
  @@map("ai_conversation_turns")
}

model AiConversationMessage {
  id                   String           @id @default(uuid()) @map("id")
  turnId               String           @map("turn_id")
  conversationId       String           @map("conversation_id")
  tenantId             String           @map("tenant_id")
  role                 ConversationRole @map("role")
  sequenceNumber       Int              @map("sequence_number")
  attemptNumber        Int              @default(1) @map("attempt_number")
  isCanonical          Boolean          @default(false) @map("is_canonical")
  status               GenerationStatus @default(PENDING) @map("status")
  content              String           @default("") @map("content") @db.Text
  sources              Json?            @map("sources")
  metadata             Json?            @map("metadata")
  errorCode            String?          @map("error_code") @db.VarChar(64)
  errorMessage         String?          @map("error_message") @db.Text
  clientMessageId      String?          @map("client_message_id") @db.VarChar(64)
  leaseToken           String?          @map("lease_token") @db.VarChar(64)
  leaseOwnerInstanceId String?          @map("lease_owner_instance_id") @db.VarChar(128)
  leaseExpiresAt       DateTime?        @map("lease_expires_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  completedAt          DateTime?        @map("completed_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  conversation   AiConversation     @relation(fields: [conversationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  turn           AiConversationTurn @relation("TurnAllMessages", fields: [turnId, conversationId, tenantId], references: [id, conversationId, tenantId], onDelete: Cascade)
  activeForTurns AiConversationTurn[] @relation("TurnActiveAttempt")

  @@unique([id, turnId, conversationId, tenantId], name: "uq_msg_id_turn_conv_tenant")
  @@unique([conversationId, sequenceNumber], name: "uq_conversation_sequence_number")
  @@index([turnId, role], name: "idx_message_turn_role")
  @@index([conversationId, createdAt(sort: Asc)], name: "idx_message_history_cursor")
  @@map("ai_conversation_messages")
}

model AiConversationAuditLog {
  id                        String   @id @default(uuid()) @map("id")
  tenantId                  String   @map("tenant_id")
  conversationId            String   @map("conversation_id")
  conversationTitleSnapshot String   @map("conversation_title_snapshot") @db.VarChar(255)
  conversationOwnerUserId   String   @map("conversation_owner_user_id")
  inspectorUserId           String   @map("inspector_user_id")
  inspectorRole             String   @map("inspector_role") @db.VarChar(64)
  action                    String   @default("CLINICAL_CONVERSATION_INSPECTED") @map("action") @db.VarChar(64)
  reason                    String   @map("reason") @db.Text
  ipAddress                 String?  @map("ip_address") @db.VarChar(45)
  userAgent                 String?  @map("user_agent") @db.Text
  createdAt                 DateTime @default(now()) @map("created_at")

  @@index([tenantId, conversationId, createdAt(sort: Desc)], name: "idx_audit_conversation")
  @@index([inspectorUserId, createdAt(sort: Desc)], name: "idx_audit_inspector")
  @@map("ai_conversation_audit_logs")
}

