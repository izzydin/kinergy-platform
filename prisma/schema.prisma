// Kinergy Platform - Prisma Database Schema
// Bounded Context: Identity & Access Management (IAM)
// Datasource: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  LOCKED
  SUSPENDED
  DEACTIVATED
}

enum RoleType {
  SYSTEM
  CUSTOM
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(PENDING_ACTIVATION)
  roleId       String     @map("role_id")
  tenantId     String?    @map("tenant_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  role Role @relation("UserToRole", fields: [roleId], references: [id], onDelete: Restrict)

  refreshTokens RefreshToken[] @relation("UserToRefreshTokens")

  @@index([email])
  @@index([roleId])
  @@index([status])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  familyId  String   @map("family_id")
  userId    String   @map("user_id")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation("UserToRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  type        RoleType @default(CUSTOM)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]           @relation("UserToRole")
  permissions RolePermission[] @relation("RoleToRolePermissions")

  @@index([name])
  @@index([type])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[] @relation("PermissionToRolePermissions")

  @@index([code])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role       Role       @relation("RoleToRolePermissions", fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation("PermissionToRolePermissions", fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], name: "unique_role_permission")
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ==========================================
// CLIENT BOUNDED CONTEXT
// ==========================================

model Client {
  id                   String   @id @default(uuid())
  referenceNumber      String   @unique @map("reference_number")
  identityId           String?  @unique @map("identity_id")
  firstName            String   @map("first_name")
  lastName             String   @map("last_name")
  email                String   @map("email")
  phone                String   @map("phone")
  normalizedEmail      String   @map("normalized_email")
  normalizedPhone      String   @map("normalized_phone")
  normalizedSearchName String   @map("normalized_search_name")
  status               String   @default("ACTIVE") @map("status")
  version              Int      @default(1) @map("version")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  timelineEntries ClientTimelineEntry[] @relation("ClientToTimeline")

  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([normalizedSearchName])
  @@index([status])
  @@map("clients")
}

model ClientTimelineEntry {
  id           String   @id @default(uuid())
  clientId     String   @map("client_id")
  sourceModule String   @map("source_module")
  eventType    String   @map("event_type")
  summary      String
  metadata     Json     @default("{}")
  occurredAt   DateTime @map("occurred_at")
  createdAt    DateTime @default(now()) @map("created_at")

  client Client @relation("ClientToTimeline", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, occurredAt(sort: Desc)])
  @@index([eventType])
  @@map("client_timeline_entries")
}

// ==========================================
// SCHEDULING BOUNDED CONTEXT
// ==========================================

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum SeriesStatus {
  ACTIVE
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum ExceptionType {
  SKIPPED
  MODIFIED
}

enum RoomStatus {
  AVAILABLE
  UNAVAILABLE
  MAINTENANCE
}

enum ResourceType {
  ROOM
  EQUIPMENT
  THERAPY_BED
  RENTAL_FACILITY
}

model RecurrenceSeries {
  id                 String              @id @default(uuid())
  clientId           String              @map("client_id")
  therapistId        String              @map("therapist_id")
  roomId             String              @map("room_id")
  serviceType        String              @map("service_type")
  frequency          RecurrenceFrequency
  startDate          DateTime            @map("start_date")
  endDate            DateTime?           @map("end_date")
  maxOccurrences     Int?                @map("max_occurrences")
  localStartHour     Int                 @map("local_start_hour")
  localStartMinute   Int                 @map("local_start_minute")
  durationMinutes    Int                 @map("duration_minutes")
  timezone           String              @default("UTC")
  status             SeriesStatus        @default(ACTIVE)
  cancellationReason String?             @map("cancellation_reason")
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  exceptions   RecurrenceException[] @relation("SeriesToExceptions")
  appointments Appointment[]         @relation("SeriesToAppointments")

  @@index([clientId])
  @@index([therapistId])
  @@index([roomId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("recurrence_series")
}

model RecurrenceException {
  id              String        @id @default(uuid())
  seriesId        String        @map("series_id")
  occurrenceIndex Int           @map("occurrence_index")
  date            DateTime      @map("date")
  type            ExceptionType @default(SKIPPED)
  reason          String?       @map("reason")
  createdAt       DateTime      @default(now()) @map("created_at")

  series RecurrenceSeries @relation("SeriesToExceptions", fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, occurrenceIndex], name: "unique_series_occurrence_exception")
  @@index([seriesId])
  @@map("recurrence_exceptions")
}

model Appointment {
  id                   String            @id @default(uuid())
  clientId             String            @map("client_id")
  therapistId          String            @map("therapist_id")
  roomId               String            @map("room_id")
  type                 String            @map("type")
  status               AppointmentStatus @default(SCHEDULED)
  startTime            DateTime          @map("start_time")
  endTime              DateTime          @map("end_time")
  seriesId             String?           @map("series_id")
  occurrenceIndex      Int?              @map("occurrence_index")
  isDetachedFromSeries Boolean           @default(false) @map("is_detached_from_series")
  cancellationReason   String?           @map("cancellation_reason")
  version              Int               @default(1)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  series RecurrenceSeries? @relation("SeriesToAppointments", fields: [seriesId], references: [id], onDelete: SetNull)
  notes  AppointmentNote[] @relation("AppointmentToNotes")

  @@unique([seriesId, occurrenceIndex], name: "unique_series_occurrence_appointment")
  @@index([clientId, startTime, endTime])
  @@index([therapistId, startTime, endTime])
  @@index([roomId, startTime, endTime])
  @@index([seriesId])
  @@index([status])
  @@index([startTime, endTime])
  @@map("appointments")
}

model AppointmentNote {
  id            String   @id @default(uuid())
  appointmentId String   @map("appointment_id")
  authorId      String   @map("author_id")
  noteText      String   @map("note_text")
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation("AppointmentToNotes", fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_notes")
}

model Room {
  id                String              @id @default(uuid())
  name              String
  capacity          Int                 @default(1)
  status            RoomStatus          @default(AVAILABLE)
  resourceType      ResourceType        @default(ROOM) @map("resource_type")
  features          String[]            @default([])
  maintenanceReason String?             @map("maintenance_reason")
  version           Int                 @default(1)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  maintenanceWindows MaintenanceWindow[] @relation("RoomToMaintenanceWindows")

  @@index([status])
  @@index([name])
  @@index([resourceType])
  @@map("rooms")
}

model MaintenanceWindow {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  reason    String?  @map("reason")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room Room @relation("RoomToMaintenanceWindows", fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startTime, endTime])
  @@index([startTime, endTime])
  @@map("maintenance_windows")
}

// ==========================================
// KINESIOLOGY BOUNDED CONTEXT
// ==========================================

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model TreatmentSession {
  id                 String        @id @default(uuid())
  clientId           String        @map("client_id")
  therapistId        String        @map("therapist_id")
  appointmentId      String        @unique @map("appointment_id")
  status             SessionStatus @default(SCHEDULED)
  cancellationReason String?       @map("cancellation_reason")
  notesSubjective    String?       @map("notes_subjective")
  notesObjective     String?       @map("notes_objective")
  notesAssessment    String?       @map("notes_assessment")
  notesPlan          String?       @map("notes_plan")
  notesRawText       String?       @map("notes_raw_text")
  version            Int           @default(1)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([clientId, createdAt(sort: Desc)])
  @@index([therapistId])
  @@index([status])
  @@index([appointmentId])
  @@map("treatment_sessions")
}

// ==========================================
// GYM MANAGEMENT BOUNDED CONTEXT (PHASE 5)
// ==========================================

enum MembershipStatus {
  PENDING
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
  TERMINATED
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CheckInMethod {
  QR_CODE
  BARCODE
  RFID
  MANUAL_RECEPTION
  BIOMETRIC
}

enum AccessResult {
  GRANTED
  DENIED_NO_MEMBERSHIP
  DENIED_EXPIRED
  DENIED_FROZEN
  DENIED_INACTIVE_CLIENT
  DENIED_OUT_OF_HOURS
  DENIED_FACILITY_MISMATCH
  DENIED_DUPLICATE_CHECKIN
  DENIED_QUOTA_EXCEEDED
  DENIED_SYSTEM_ERROR
}

model MembershipPlan {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  description   String?
  durationDays  Int            @map("duration_days")
  priceAmount   Decimal        @db.Decimal(10, 2) @map("price_amount")
  priceCurrency String         @default("USD") @map("price_currency")
  visitQuota    Int?           @map("visit_quota")
  status        PlanStatus     @default(DRAFT)
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  memberships   Membership[]   @relation("PlanToMemberships")

  @@index([code])
  @@index([status])
  @@map("membership_plans")
}

model Membership {
  id                 String             @id @default(uuid())
  clientId           String             @map("client_id")
  planId             String             @map("plan_id")
  status             MembershipStatus   @default(ACTIVE)
  startDate          DateTime           @map("start_date")
  endDate            DateTime           @map("end_date")
  assignedTrainerId  String?            @map("assigned_trainer_id")
  freezeHistory      Json               @default("[]") @map("freeze_history")
  cancellationReason String?            @map("cancellation_reason")
  terminationReason  String?            @map("termination_reason")
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  plan               MembershipPlan     @relation("PlanToMemberships", fields: [planId], references: [id], onDelete: Restrict)
  attendanceRecords  AttendanceRecord[] @relation("MembershipToAttendance")

  @@index([clientId, status])
  @@index([planId])
  @@index([status, endDate])
  @@index([assignedTrainerId])
  @@map("memberships")
}

model AttendanceRecord {
  id             String         @id @default(uuid())
  clientId       String         @map("client_id")
  membershipId   String?        @map("membership_id")
  checkInTime    DateTime       @map("check_in_time")
  gymDay         String         @map("gym_day")
  method         CheckInMethod
  result         AccessResult
  gateId         String?        @map("gate_id")
  receptionistId String?        @map("receptionist_id")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")

  membership     Membership?    @relation("MembershipToAttendance", fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([clientId, checkInTime(sort: Desc)])
  @@index([gymDay])
  @@index([membershipId])
  @@index([result])
  @@map("attendance_records")
}

