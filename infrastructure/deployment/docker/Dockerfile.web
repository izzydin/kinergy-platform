# ==============================================================================
# Kinergy Platform - Web Production Container Specification (Dockerfile.web)
# Architecture: React 18 / Vite 5 / Nginx Unprivileged (Alpine Slim)
# Standard: Non-root execution (nginx UID 101), multi-stage, SPA fallback routing
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Frontend Web Application Builder
# ------------------------------------------------------------------------------
FROM node:24.12.0-bookworm-slim AS web-builder

WORKDIR /app

ENV CI=true

RUN npm install -g pnpm@11.17.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY modules/client/package.json ./modules/client/
COPY packages/core/package.json ./packages/core/
COPY prisma ./prisma

RUN pnpm install --frozen-lockfile

COPY tsconfig.base.json nx.json ./
COPY apps/web ./apps/web
COPY packages ./packages
COPY modules ./modules

# Invariant Public Browser Configuration (Root-relative API gateway contract)
ENV MODE=production \
    VITE_API_BASE_URL=/api/v1 \
    VITE_APP_TITLE="Kinergy Platform" \
    VITE_ENABLE_MSW=false \
    VITE_ENABLE_TELEMETRY=true

RUN pnpm nx build web --configuration=production && \
    rm -f /app/dist/apps/web/mockServiceWorker.js

# ------------------------------------------------------------------------------
# Stage 2: Minimal Unprivileged Nginx Runtime
# ------------------------------------------------------------------------------
FROM nginxinc/nginx-unprivileged:1.27-alpine-slim AS web-runner

USER nginx

# Copy custom Nginx configuration (SPA history fallback + /api/v1 proxying)
COPY infrastructure/deployment/docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --chown=nginx:nginx --from=web-builder /app/dist/apps/web /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
