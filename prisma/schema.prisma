// Kinergy Platform - Prisma Database Schema
// Bounded Context: Identity & Access Management (IAM)
// Datasource: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  LOCKED
  SUSPENDED
  DEACTIVATED
}

enum RoleType {
  SYSTEM
  CUSTOM
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(PENDING_ACTIVATION)
  roleId       String     @map("role_id")
  tenantId     String?    @map("tenant_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  role Role @relation("UserToRole", fields: [roleId], references: [id], onDelete: Restrict)

  refreshTokens RefreshToken[] @relation("UserToRefreshTokens")

  @@index([email])
  @@index([roleId])
  @@index([status])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  familyId  String   @map("family_id")
  userId    String   @map("user_id")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation("UserToRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  type        RoleType @default(CUSTOM)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]           @relation("UserToRole")
  permissions RolePermission[] @relation("RoleToRolePermissions")

  @@index([name])
  @@index([type])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[] @relation("PermissionToRolePermissions")

  @@index([code])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role       Role       @relation("RoleToRolePermissions", fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation("PermissionToRolePermissions", fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], name: "unique_role_permission")
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ==========================================
// CLIENT BOUNDED CONTEXT
// ==========================================

model Client {
  id                   String   @id @default(uuid())
  referenceNumber      String   @unique @map("reference_number")
  identityId           String?  @unique @map("identity_id")
  firstName            String   @map("first_name")
  lastName             String   @map("last_name")
  email                String   @map("email")
  phone                String   @map("phone")
  normalizedEmail      String   @map("normalized_email")
  normalizedPhone      String   @map("normalized_phone")
  normalizedSearchName String   @map("normalized_search_name")
  status               String   @default("ACTIVE") @map("status")
  version              Int      @default(1) @map("version")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  timelineEntries ClientTimelineEntry[] @relation("ClientToTimeline")

  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([normalizedSearchName])
  @@index([status])
  @@map("clients")
}

model ClientTimelineEntry {
  id           String   @id @default(uuid())
  clientId     String   @map("client_id")
  sourceModule String   @map("source_module")
  eventType    String   @map("event_type")
  summary      String
  metadata     Json     @default("{}")
  occurredAt   DateTime @map("occurred_at")
  createdAt    DateTime @default(now()) @map("created_at")

  client Client @relation("ClientToTimeline", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([eventType])
  @@index([occurredAt])
  @@map("client_timeline_entries")
}

