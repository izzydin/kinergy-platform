# ==============================================================================
# Kinergy Platform - Complete Environment Configuration Reference (.env.example)
# Validation Engine: Zod (apps/api/src/config/env.validation.ts)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Execution Environment
# ------------------------------------------------------------------------------
# Application execution mode ('development' | 'test' | 'production')
NODE_ENV=development

# HTTP web server listening port (Range: 1000 - 65535)
PORT=3000

# Global REST API route prefix
API_PREFIX=api/v1

# OpenAPI Swagger Documentation UI Toggle ('true' | 'false')
SWAGGER_ENABLED=true

# ------------------------------------------------------------------------------
# 2. Database & Persistence Infrastructure
# ------------------------------------------------------------------------------
# Primary PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kinergy_db?schema=public

# ------------------------------------------------------------------------------
# 3. Cryptographic Security Secrets (CRITICAL)
# ------------------------------------------------------------------------------
# Access Token Signing Secret (MUST be >= 32 characters. Dev default REJECTED in production)
JWT_ACCESS_SECRET=kinergy-platform-dev-access-secret-min-32-chars!

# Refresh Token Signing Secret (MUST be >= 32 characters. Dev default REJECTED in production)
JWT_REFRESH_SECRET=kinergy-platform-dev-refresh-secret-min-32-chars!

# Access Token expiration duration (e.g. '15m', '1h')
JWT_ACCESS_EXPIRES_IN=15m

# Refresh Token expiration duration (e.g. '7d', '30d')
JWT_REFRESH_EXPIRES_IN=7d

# JWT Claims Standard Issuer ('iss')
JWT_ISSUER=kinergy-platform

# JWT Claims Standard Audience ('aud')
JWT_AUDIENCE=kinergy-api

# ------------------------------------------------------------------------------
# 4. Web Security & CORS Configuration
# ------------------------------------------------------------------------------
# Allowed CORS Origins (Comma-separated URLs. Wildcard '*' PROHIBITED in production)
CORS_ORIGINS=http://localhost:4200,http://localhost:5173

# Allowed HTTP Methods for CORS
CORS_ALLOWED_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS

# Allowed HTTP Headers for CORS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin,X-Tenant-ID

# Exposed HTTP Headers for CORS
CORS_EXPOSED_HEADERS=Content-Range,X-Content-Range,X-Total-Count,X-Request-ID

# Preflight Options Cache Max Age (seconds)
CORS_MAX_AGE=86400

# Allow Credentials (Cookies / Authorization Headers) ('true' | 'false')
CORS_ALLOW_CREDENTIALS=true

# Optional Tenant Subdomain Regex Pattern (e.g. '.*\.kinergy\.com$')
# CORS_TENANT_DOMAIN_PATTERN=

# ------------------------------------------------------------------------------
# 5. Transport Rate Limiting Settings
# ------------------------------------------------------------------------------
# Login Route Rate Limit (Max requests per window)
AUTH_LOGIN_LIMIT=5
AUTH_LOGIN_WINDOW=60

# Refresh Token Rate Limit (Max requests per window)
AUTH_REFRESH_LIMIT=20
AUTH_REFRESH_WINDOW=60

# Logout Route Rate Limit (Max requests per window)
AUTH_LOGOUT_LIMIT=30
AUTH_LOGOUT_WINDOW=60

# Current User (/auth/me) Rate Limit (Max requests per window)
AUTH_ME_LIMIT=60
AUTH_ME_WINDOW=60

# ------------------------------------------------------------------------------
# 6. Argon2id Password Hashing Parameters
# ------------------------------------------------------------------------------
# Argon2id Memory Cost (in KB. Min 15360 KB / Recommended 65536 KB = 64 MB)
ARGON2_MEMORY_COST=65536

# Argon2id Time Cost (Iterations. Min 1 / Recommended 3)
ARGON2_TIME_COST=3

# Argon2id Parallelism Threads (Min 1 / Recommended 4)
ARGON2_PARALLELISM=4

# Argon2id Hash Output Digest Length (bytes)
ARGON2_HASH_LENGTH=32

# ------------------------------------------------------------------------------
# 7. Password Complexity & Lifecycle Policy
# ------------------------------------------------------------------------------
# Password Length Limits (Min 8 / Max 128)
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

# Mandatory Complexity Checks ('true' | 'false')
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL_CHAR=true

# Password Reuse Prevention History Limit (0 to 24)
PASSWORD_HISTORY_LIMIT=5
